---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Cooties@Blog" description="This page doesn't exist.">
  <section class="band not-found contour-field contour-field--hero">
    <div class="container">
      <h1>Off the map.</h1>
      <p class="lede">This page doesn't exist, or it moved. The research index lists every published post.</p>
      <a class="back" href="/">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Go to the research index
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(5rem, 3rem + 8vw, 10rem);
    --contour-opacity: 0.55;
  }

  .lede {
    margin-top: 1.25rem;
    font-size: clamp(1.125rem, 1.05rem + 0.45vw, 1.375rem);
    color: var(--ink-2);
    max-width: 40ch;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    margin-top: 1.5rem;
    font-family: var(--font-ui);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }
</style>
