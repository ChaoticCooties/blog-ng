---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const GITHUB_URL = 'https://github.com/chaoticcooties';

const published = await getCollection('blog', ({ data }) => data.draft !== true);
const postBySlug = new Map(published.map((post) => [post.slug, post]));

const umbra = postBySlug.get('project-umbra');

// Focus areas mirror the post categories, so About and the index filters agree.
const focusAreas = [
  {
    title: 'AI safety',
    summary: 'How language models behave under adversarial pressure, and where AI safety and AI security meet.',
  },
  {
    title: 'Cybersecurity',
    summary: 'Offensive security work, from supply-chain vulnerability research to how AI is changing the field.',
  },
].map((area) => ({
  ...area,
  href: `/?topic=${encodeURIComponent(area.title)}`,
  posts: published
    .filter((post) => post.data.category === area.title)
    .sort((x, y) => y.data.date.valueOf() - x.data.date.valueOf()),
}));
---

<BaseLayout
  title="About | Cooties@Blog"
  description="About Cooties@Blog, Chegne Eu Joe's research blog on AI security, LLM pentesting, and supply-chain vulnerability research."
>
  <section class="band statement contour-field contour-field--statement contour-field--corner">
    <div class="container">
      <h1>Hands-on research in AI and security.</h1>
      <div class="statement-body">
        <p class="statement-byline">Chegne Eu Joe</p>
        <p class="lede">
          Cooties@Blog is where I write up projects, experiments, and observations across security, software, and intelligent systems.
        </p>
        <p class="lede-sub">
          I'm an offensive security professional and an aspiring AI safety researcher. I research how things break, and I apply an adversarial mindset to probing and attacking systems.
        </p>
      </div>
    </div>
  </section>

  {umbra && (
    <section class="band band--white proof">
      <div class="container split">
        <p class="side-label">From the field</p>
        <figure class="proof-quote">
          <blockquote>
            <p>Over the course of testing, the scanner independently identified a real, actively exploited backdoor.</p>
          </blockquote>
          <figcaption>
            <p class="proof-source">From <cite>{umbra.data.title}</cite>, {umbra.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', timeZone: 'UTC' })}</p>
            <p class="proof-context">
              It found it through contextual reasoning about code behavior, not by matching known malicious signatures.
            </p>
            <a class="arrow-link" href={`/blog/${umbra.slug}`}>
              <span>Read the full post<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg></span>
            </a>
          </figcaption>
        </figure>
      </div>
    </section>
  )}

  <section class="band contour-field soft-contours">
    <div class="container split">
      <p class="side-label">The work</p>
      <div class="prose">
        <h2>Write-ups of real technical work</h2>
        <p>
          Posts range from small proofs of concept to deeper investigations into how real systems behave, fail, and interact in practice. Each one covers what I learned, what worked, what didn't, and why it matters.
        </p>
        <p>
          Understanding a concept deeply matters as much to me as testing it in a real system. I study the ideas behind a technology, then examine how it behaves when it's built, stressed, or applied in context. The goal is always a clear, practical insight you can apply to your own projects or research.
        </p>
      </div>
    </div>
  </section>

  <section class="band band--white">
    <div class="container split">
      <p class="side-label">Focus areas</p>
      <ul class="areas">
        {focusAreas.map((area) => (
          <li class="area">
            <h3><a class="area-title" href={area.href}>{area.title}</a></h3>
            <p>{area.summary}</p>
            <ul class="area-posts">
              {area.posts.map((post) => (
                <li>
                  <a class="arrow-link" href={`/blog/${post.slug}`}>
                    <span>{post.data.title}<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg></span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band--deep connect contour-field">
    <div class="container split">
      <p class="side-label">Connect</p>
      <div class="prose">
        <h2>Get in touch</h2>
        <p>
          To discuss these projects, AI security, or a possible collaboration, reach out on GitHub.
        </p>
        <div class="actions">
          <a class="btn btn--light" href={GITHUB_URL} rel="me">GitHub</a>
          <a class="btn btn--ghost" href="/">Read the research</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .statement {
    padding-block: clamp(4rem, 2.5rem + 7vw, 9rem);
    --contour-opacity: 0.55;
  }

  .statement h1 {
    font-size: clamp(2.75rem, 1.5rem + 5.2vw, 5.75rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 16ch;
  }

  .statement-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 1rem 4rem;
    margin-top: clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  .statement-byline {
    grid-column: 1;
    grid-row: 1 / span 2;
    padding-top: 0.35rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.125rem;
    color: var(--ink-2);
  }

  .statement-body .lede {
    grid-column: 2;
    font-size: clamp(1.1875rem, 1.05rem + 0.55vw, 1.4375rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    max-width: 40ch;
  }

  .lede-sub {
    grid-column: 2;
    font-size: 1.0625rem;
    color: var(--ink-2);
    max-width: 52ch;
  }

  .side-label {
    padding-top: 0.5rem;
  }

  .soft-contours {
    --contour-opacity: 0.28;
  }

  /* Proof: one real finding at display size. */
  .proof-quote blockquote p {
    font-family: var(--font-display);
    font-weight: 500;
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 24;
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.75rem);
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: balance;
  }

  .proof-quote blockquote p::before {
    content: '\201C';
    color: var(--accent);
    margin-left: -0.45em;
  }

  .proof-quote blockquote p::after {
    content: '\201D';
    color: var(--accent);
  }

  .proof-quote figcaption {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--accent);
    max-width: 48ch;
  }

  .proof-source {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink-3);
    margin-bottom: 0.5rem;
  }

  .proof-context {
    color: var(--ink-2);
    margin-bottom: 1rem;
  }

  .arrow-link {
    display: inline-block;
    padding-block: 0.6rem;
    font-family: var(--font-ui);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }

  .arrow-link svg {
    display: inline-block;
    vertical-align: -0.15em;
    margin-left: 0.35rem;
    transition: transform 0.2s var(--ease-out);
  }

  .arrow-link:hover svg {
    transform: translateX(3px);
  }

  .arrow-link span {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
    text-underline-offset: 0.2em;
  }

  .prose {
    max-width: 40rem;
  }

  .prose h2 {
    margin-bottom: 1.25rem;
  }

  .prose p + p {
    margin-top: 1.1rem;
  }

  .prose p {
    font-size: 1.125rem;
    color: var(--ink-2);
  }

  /* Focus areas: three ruled columns, no boxes. */
  .areas {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
  }

  .area {
    padding-top: 1.25rem;
    border-top: 2px solid var(--accent);
  }

  .area h3 {
    margin-bottom: 0.625rem;
  }

  .area > p {
    color: var(--ink-2);
    font-size: 1rem;
  }

  .area-posts {
    list-style: none;
    margin-top: 1rem;
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .area-posts .arrow-link {
    padding-block: 0.4rem;
  }

  .area-title {
    text-decoration: none;
  }

  .area-title:hover {
    color: var(--accent);
  }

  /* Connect band */
  .connect {
    --contour-opacity: 0.7;
  }




  .connect .prose p {
    color: var(--on-deep-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.7rem 1.4rem;
    border-radius: 8px;
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s var(--ease-out), color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .btn--light {
    background: var(--paper);
    color: var(--accent-deep);
    border: 1px solid var(--paper);
  }

  .btn--light:hover {
    background: var(--bg);
    color: var(--accent-deep);
  }

  .btn--ghost {
    color: var(--on-deep);
    border: 1px solid var(--on-deep-line);
  }

  .btn--ghost:hover {
    color: var(--on-deep-strong);
    border-color: var(--on-deep);
  }

  @media (max-width: 1000px) {
    .areas {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 800px) {
    .statement-body {
      grid-template-columns: 1fr;
    }

    .statement-body .lede,
    .lede-sub,
    .statement-byline {
      grid-column: 1;
      grid-row: auto;
    }

    /* Once the split collapses, labels would stack as eyebrows; drop them. */
    .side-label {
      display: none;
    }

    .proof-quote blockquote p::before {
      margin-left: 0;
    }


  }
</style>
