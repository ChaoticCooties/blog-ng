---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const published = await getCollection('blog', ({ data }) => data.draft !== true);

// Newest first
const posts = published
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => ({
    title: post.data.title,
    date: post.data.date,
    description: post.data.description,
    slug: post.slug,
    category: post.data.category,
  }));

const categories = ['All', ...[...new Set(posts.map((post) => post.category))].sort()];
const countFor = (cat: string) =>
  cat === 'All' ? posts.length : posts.filter((p) => p.category === cat).length;
---

<BaseLayout
  title="Cooties@Blog | AI and security research"
  description="Technical write-ups on AI security, LLM pentesting, and supply-chain vulnerability research."
>
  <section class="band hero contour-field contour-field--hero">
    <div class="container">
      <div class="hero-text">
        <h1>Research</h1>
        <p class="lede">
          Technical projects and experiments that test how emerging technologies work in practice, with a focus on AI security.
        </p>
      </div>
    </div>
  </section>

  <section class="band band--white listing" aria-label="Posts">
    <div class="container split">
      <aside class="filters-col">
        <p class="side-label" id="filter-label">Filter by</p>
        <div class="filters" role="group" aria-labelledby="filter-label">
          {categories.map((cat) => (
            <button
              type="button"
              class="filter-btn"
              data-category={cat}
              aria-pressed={cat === 'All' ? 'true' : 'false'}
            >
              {cat}
              <span class="count">{countFor(cat)}<span class="visually-hidden"> posts</span></span>
            </button>
          ))}
        </div>
      </aside>

      <div class="posts">
        {posts.map((post, index) => (
          <div class="post-slot" data-category={post.category}>
            <PostCard {...post} featured={index === 0} />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    --contour-opacity: 0.55;
  }




  .hero-text {
    max-width: 48rem;
  }

  .hero-text h1 {
    margin-bottom: 1.25rem;
  }

  .lede {
    font-size: clamp(1.125rem, 1.05rem + 0.45vw, 1.375rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--ink-2);
    max-width: 36ch;
  }

  .filters-col {
    position: sticky;
    top: 2rem;
    align-self: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule-strong);
  }

  .filters {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: var(--paper);
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    color: var(--ink-2);
    cursor: pointer;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out), background-color 0.2s var(--ease-out);
  }

  .filter-btn:hover {
    border-color: var(--ink-3);
    color: var(--ink);
  }

  .filter-btn[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }

  .count {
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
  }

  .filter-btn[aria-pressed='true'] .count {
    color: var(--paper);
  }

  .posts {
    border-bottom: 1px solid var(--rule-strong);
  }

  .post-slot[hidden] {
    display: none;
  }

  .post-slot.revealed {
    animation: slot-in 0.4s var(--ease-out) both;
  }

  @keyframes slot-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-slot.revealed { animation: none; }
  }

  @media (max-width: 800px) {


    .filters-col {
      position: static;
      border-top: 0;
      padding-top: 0;
    }

    .filters {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .filter-btn {
      min-height: 44px;
    }
  }
</style>

<script>
  // Category filter. The selected topic is kept in the URL (?topic=)
  // so it survives Back and can be shared.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filter-btn')];
  const slots = document.querySelectorAll<HTMLElement>('.post-slot');

  const applyFilter = (category: string, animate: boolean) => {
    buttons.forEach((btn) => btn.setAttribute('aria-pressed', String(btn.dataset.category === category)));
    slots.forEach((slot) => {
      const show = category === 'All' || slot.dataset.category === category;
      const wasHidden = slot.hidden;
      slot.hidden = !show;
      slot.classList.toggle('revealed', animate && show && wasHidden);
    });
  };

  const fromUrl = new URLSearchParams(location.search).get('topic');
  if (fromUrl && buttons.some((btn) => btn.dataset.category === fromUrl)) {
    applyFilter(fromUrl, false);
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const category = button.dataset.category ?? 'All';
      applyFilter(category, true);
      const url = new URL(location.href);
      if (category === 'All') url.searchParams.delete('topic');
      else url.searchParams.set('topic', category);
      history.replaceState(null, '', url);
    });
  });
</script>
