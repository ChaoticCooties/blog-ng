---
/*
  Design direction contract (Impeccable). Source-only; not shipped.
  See DESIGN.md for the recorded system.
  THESIS: The research-lab journal (Transformer Circuits, OpenAI interpretability, Goodfire structure) set in a naturalist field survey; refuses stock topo wallpaper and cream-and-serif nature cliches.
  OWN-WORLD: Lichen off-white #F1F4EC with fine paper grain, moss ink #1C2B21, fern accent #36704D, forest band #1D3526; generated topographic contour fields (index contours heavier) in heroes and bands only; Literata titles and italic map-annotation labels, Geist text; original robot logo untouched, header only.
  STORY: A reader lands on a surveyed field of work, sees the strongest finding, opens a post, and reads it on a clean page with a contents rail and wide figures.
  FIRST VIEWPORT: Header with robot logo; hero band on a contour field with the Literata title and lede left-aligned; post list begins within the first screen.
  FORM: Field Survey, position 4 of 7; seed e068c7cc.
  FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
*/
import '../styles/global.css';
import CodeCopyButton from '../components/CodeCopyButton.astro';
import Logo from '../components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  math?: boolean;
}

const {
  title = 'Cooties@Blog | AI and security research',
  description = 'Technical write-ups on AI security, LLM pentesting, and supply-chain vulnerability research.',
  image = '/og-image.png',  // Use PNG for better LinkedIn/social media support
  math = false,
} = Astro.props;

const siteUrl = Astro.site || 'https://cooties.io';
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
const path = Astro.url.pathname;
const isResearch = path === '/' || path.startsWith('/blog');
const isAbout = path.startsWith('/about');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="theme-color" content="#F1F4EC">
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="alternate" type="application/rss+xml" title="Cooties@Blog" href="/rss.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&family=Literata:ital,opsz,wght@0,7..72,400..600;1,7..72,400..500&display=swap">

  <!-- Open Graph / Facebook / LinkedIn -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={pageUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={imageUrl}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={title}>

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content={pageUrl}>
  <meta property="twitter:title" content={title}>
  <meta property="twitter:description" content={description}>
  <meta property="twitter:image" content={imageUrl}>

  {math && (
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">
  )}
</head>
<body>

  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <nav class="container nav" aria-label="Primary">
      <a href="/" class="brand" aria-label="Cooties@Blog home">
        <Logo size={50} class="brand-mark" />
        <span class="brand-name">Cooties</span>
      </a>
      <div class="nav-links">
        <a href="/" aria-current={isResearch ? 'page' : undefined}>Research</a>
        <a href="/about" aria-current={isAbout ? 'page' : undefined}>About</a>
      </div>
    </nav>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p class="meta">&copy; {new Date().getFullYear()} Chegne Eu Joe.</p>
      <p class="meta footer-links"><a href="/">Research</a> · <a href="/about">About</a> · <a href="/rss.xml">RSS</a></p>
    </div>
  </footer>

  <CodeCopyButton />
</body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    min-height: 4.5rem;
    padding-block: 0.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand :global(.brand-mark) {
    display: block;
    flex-shrink: 0;
    margin-top: -6px;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    gap: 1.75rem;
    font-family: var(--font-ui);
    font-size: 0.9375rem;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-2);
    text-decoration: none;
  }

  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--ink);
  }

  .nav-links a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
  }

  main {
    min-height: calc(100vh - 12rem);
  }

  .site-footer {
    margin-top: 7rem;
    border-top: 1px solid var(--rule);
  }

  /* Pages that end on a full-bleed band meet the footer directly. */
  main:has(> :last-child.band) + .site-footer {
    margin-top: 0;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.5rem 2rem;
  }

  .footer-inner a {
    display: inline-block;
    padding-block: 0.6rem;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .nav {
      min-height: 3.5rem;
    }

    .nav-links {
      gap: 1.25rem;
    }

    .site-footer {
      margin-top: 5rem;
    }

    main:has(> :last-child.band) + .site-footer {
      margin-top: 0;
    }
  }
</style>
