    <text x="112.0" y="404.0" font-family="'Geist', system-ui, sans-serif" font-size="9" fill="#56665A" text-anchor="middle">r0</text>
    <text x="208.5" y="388.0" font-family="'Geist', system-ui, sans-serif" font-size="10" fill="#435347" text-anchor="middle">"be organised"</text>
    <text x="208.5" y="404.0" font-family="'Geist', system-ui, sans-serif" font-size="9" fill="#56665A" text-anchor="middle">r1</text>
    <text x="305.0" y="388.0" font-family="'Geist', system-ui, sans-serif" font-size="10" fill="#435347" text-anchor="middle">one named</text>
    <text x="305.0" y="400.0" font-family="'Geist', system-ui, sans-serif" font-size="10" fill="#435347" text-anchor="middle">element</text>
    <text x="305.0" y="416.0" font-family="'Geist', system-ui, sans-serif" font-size="9" fill="#56665A" text-anchor="middle">r2</text>
    <text x="401.5" y="388.0" font-family="'Geist', system-ui, sans-serif" font-size="10" fill="#435347" text-anchor="middle" font-weight="600">two named</text>
