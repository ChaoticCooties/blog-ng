    <text x="94.0" y="219.9" font-family="'Geist', system-ui, sans-serif" font-size="10" fill="#56665A" text-anchor="end">−0.15</text>
    <line x1="102.0" y1="254.2" x2="538.0" y2="254.2" stroke="#D6DECF" stroke-width="1"/>
    <text x="94.0" y="257.7" font-family="'Geist', system-ui, sans-serif" font-size="10" fill="#56665A" text-anchor="end">−0.20</text>
