<figure class="diagram dual-llm">
  <div class="diagram-scroll">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 62 880 258" role="img" aria-labelledby="dualllmdiagram-title dualllmdiagram-desc">
    <title id="dualllmdiagram-title">Dual LLM filter architecture</title>
    <desc id="dualllmdiagram-desc">A filter LLM passes input through; the application LLM combines it with context and processes the result.</desc>
    <defs>
        <marker id="arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
        <polygon points="0 0, 10 3, 0 6" fill="#435347"/>
        </marker>
    </defs>

    <!-- Title -->

    <!-- Main panel -->
    <rect x="40" y="70" width="800" height="220" rx="6"
            fill="none" stroke="#B9C7B2" stroke-width="2"/>

    <!-- User input -->
    <rect x="60" y="120" width="150" height="64" rx="6"
            fill="#FAFBF7" stroke="#B9C7B2" stroke-width="2"/>
    <text x="135" y="142" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="13" fill="#1C2B21">
        User Input
    </text>
    <text x="135" y="160" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="11" fill="#435347">
        benign wrapper +
    </text>
    <text x="135" y="176" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="11" fill="#435347">
        encoded adversarial intent
    </text>

    <!-- Arrow: user -> filter -->
    <line x1="210" y1="152" x2="270" y2="152"
            stroke="#435347" stroke-width="2" marker-end="url(#arrow)"/>

    <!-- Filter LLM -->
    <rect x="270" y="120" width="170" height="64" rx="6"
            fill="#DCE8D9" stroke="#36704D" stroke-width="2"/>
    <text x="355" y="140" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="13" font-weight="600" fill="#36704D">
        Filter LLM
    </text>
    <text x="355" y="160" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="11" fill="#435347">
        "Is this input safe?"
    </text>
    <text x="355" y="176" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="10" fill="#56665A">
        classification and basic guardrails
    </text>

    <!-- Arrow: filter -> app LLM -->
    <line x1="440" y1="152" x2="500" y2="152"
            stroke="#435347" stroke-width="2" marker-end="url(#arrow)"/>
    <text x="470" y="170" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="10" fill="#56665A">
        passes through as "safe"
    </text>

    <!-- Application LLM -->
    <rect x="500" y="120" width="170" height="64" rx="6"
            fill="#36704D"/>
    <text x="585" y="140" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="13" font-weight="600" fill="#FAFBF7">
        Application LLM
    </text>
    <text x="585" y="160" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="11" fill="#FAFBF7">
        combines user input
    </text>
    <text x="585" y="176" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="11" fill="#FAFBF7">
        with system context and tools
    </text>

    <!-- Output -->
    <line x1="670" y1="152" x2="730" y2="152"
            stroke="#435347" stroke-width="2" marker-end="url(#arrow)"/>

    <rect x="730" y="120" width="90" height="64" rx="6"
            fill="#FAFBF7" stroke="#B9C7B2" stroke-width="2"/>
    <text x="775" y="144" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="12" fill="#1C2B21">
        Output
    </text>
    <text x="775" y="162" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="10" fill="#36704D">
        injection
    </text>

    <!-- Shared vulnerability note -->
    <text x="355" y="100" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="10" fill="#435347">
        Both LLMs inherit the same
    </text>
    <text x="355" y="112" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="10" fill="#435347">
        architectural weaknesses
    </text>

    <!-- Context box feeding into Application LLM -->
    <rect x="460" y="210" width="260" height="56" rx="6"
            fill="#FAFBF7" stroke="#B9C7B2" stroke-width="2"/>
    <text x="590" y="228" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="11" fill="#1C2B21">
        System prompts, RAG documents,
    </text>
    <text x="590" y="244" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="11" fill="#1C2B21">
        tool outputs, and other context
    </text>

    <!-- Arrow from context up into Application LLM -->
    <line x1="590" y1="210" x2="590" y2="184"
            stroke="#435347" stroke-width="2" marker-end="url(#arrow)"/>

    <text x="600" y="200"
            font-family="'Geist', system-ui, sans-serif"
            font-size="10" fill="#435347">
        changes interpretation
    </text>

    <!-- Multi-stage attack hint -->
    <text x="175" y="220"
            font-family="'Geist', system-ui, sans-serif"
            font-size="10" fill="#435347">
        Filter sees input in isolation
    </text>
    <text x="205" y="236"
            font-family="'Geist', system-ui, sans-serif"
            font-size="10" fill="#36704D">
        Application LLM sees full injection
    </text>
    </svg>
</div>
  <figcaption><span class="figure-title">Dual LLM filter architecture.</span> A filter LLM passes input through; the application LLM combines it with context and processes the result.</figcaption>
</figure>