<figure class="diagram fuzzyboundary-diagram">
  <div class="diagram-scroll">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 72 1200 428" role="img" aria-labelledby="fuzzyboundaries-title fuzzyboundaries-desc">
    <title id="fuzzyboundaries-title">Deterministic vs. stochastic decision boundaries</title>
    <desc id="fuzzyboundaries-desc">Deterministic systems have a clear boundary; LLMs operate with a stochastic band where outcomes overlap.</desc>
    <!-- Title -->

    <!-- LEFT PANEL: Deterministic -->
    <g id="deterministic">
        <rect x="60" y="90" width="500" height="320" fill="none" stroke="#B9C7B2" stroke-width="2" rx="6"/>
        
        <text x="310" y="120" font-family="'Geist', system-ui, sans-serif" font-size="16"
            font-weight="600" fill="#435347" text-anchor="middle">
        Deterministic Boundary
        </text>

        <!-- Axes -->
        <line x1="120" y1="330" x2="420" y2="330" stroke="#B9C7B2" stroke-width="2"/>
        <line x1="140" y1="160" x2="140" y2="340" stroke="#B9C7B2" stroke-width="2"/>

        <!-- Sharp boundary -->
        <line x1="180" y1="180" x2="400" y2="320" stroke="#36704D" stroke-width="3"/>

        <!-- Points (safe region) -->
        <circle cx="190" cy="290" r="7" fill="#FAFBF7" stroke="#1C2B21" stroke-width="2"/>
        <circle cx="230" cy="270" r="7" fill="#FAFBF7" stroke="#1C2B21" stroke-width="2"/>
        <circle cx="270" cy="250" r="7" fill="#FAFBF7" stroke="#1C2B21" stroke-width="2"/>

        <!-- Points (unsafe region) -->
        <circle cx="260" cy="200" r="7" fill="#36704D" opacity="0.15" stroke="#36704D" stroke-width="2"/>
        <circle cx="310" cy="210" r="7" fill="#36704D" opacity="0.15" stroke="#36704D" stroke-width="2"/>
        <circle cx="360" cy="230" r="7" fill="#36704D" opacity="0.15" stroke="#36704D" stroke-width="2"/>

        <text x="200" y="365" font-family="'Geist', system-ui, sans-serif" font-size="13" fill="#435347">
        Inputs fall clearly on one side
        <tspan x="200" dy="18">of a hard boundary.</tspan>
        </text>
    </g>

    <!-- RIGHT PANEL: Stochastic (same layout, fuzzy region instead of line) -->
    <g id="stochastic">
        <rect x="640" y="90" width="500" height="320" fill="none" stroke="#B9C7B2" stroke-width="2" rx="6"/>

        <text x="890" y="120" font-family="'Geist', system-ui, sans-serif" font-size="16"
            font-weight="600" fill="#435347" text-anchor="middle">
        Stochastic Boundary (LLMs)
        </text>

        <!-- Axes -->
        <line x1="700" y1="330" x2="1000" y2="330" stroke="#B9C7B2" stroke-width="2"/>
        <line x1="720" y1="160" x2="720" y2="340" stroke="#B9C7B2" stroke-width="2"/>

        <!-- Fuzzy region (replaces crisp line) -->
        <defs>
        <linearGradient id="fuzzyBandV" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#36704D" stop-opacity="0.10"/>
            <stop offset="50%" stop-color="#36704D" stop-opacity="0.30"/>
            <stop offset="100%" stop-color="#36704D" stop-opacity="0.10"/>
        </linearGradient>
        </defs>

        <!-- A band approximating fuzzy boundary -->
        <path d="M 740 200 C 820 230 900 230 980 260 
                L 980 300 C 900 270 820 260 740 230 Z"
            fill="url(#fuzzyBandV)" stroke="#36704D" stroke-width="2" stroke-dasharray="6 4"/>

        <!-- Points scattered across regions -->
        <!-- Safe-ish region -->
        <circle cx="760" cy="300" r="7" fill="#FAFBF7" stroke="#1C2B21" stroke-width="2"/>
        <circle cx="800" cy="280" r="7" fill="#FAFBF7" stroke="#1C2B21" stroke-width="2"/>
        <circle cx="840" cy="260" r="7" fill="#FAFBF7" stroke="#1C2B21" stroke-width="2"/>

        <!-- Uncertain region (inside fuzzy band) -->
        <circle cx="870" cy="245" r="7" fill="#36704D" opacity="0.25" stroke="#36704D" stroke-width="2"/>
        <circle cx="915" cy="255" r="7" fill="#36704D" opacity="0.25" stroke="#36704D" stroke-width="2"/>

        <!-- Unsafe-ish region -->
        <circle cx="950" cy="290" r="7" fill="#36704D" opacity="0.15" stroke="#36704D" stroke-width="2"/>
        <circle cx="920" cy="310" r="7" fill="#36704D" opacity="0.15" stroke="#36704D" stroke-width="2"/>

        <text x="890" y="365" font-family="'Geist', system-ui, sans-serif" font-size="13" fill="#435347" text-anchor="middle">
        The same input can land anywhere inside
        <tspan x="890" dy="18">a fuzzy band of possible outcomes.</tspan>
        </text>
    </g>

    <!-- Legend -->
    <g id="legend" transform="translate(60, 440)">
        <text x="0" y="0" font-family="'Geist', system-ui, sans-serif" font-size="14" font-weight="600" fill="#435347">
        Key Idea:
        </text>
        <text x="0" y="24" font-family="'Geist', system-ui, sans-serif" font-size="13" fill="#435347">
        Deterministic systems have a <tspan font-weight="600" fill="#1C2B21">clear boundary</tspan>,
        while LLMs operate with a
        </text>
        <text x="0" y="42" font-family="'Geist', system-ui, sans-serif" font-size="13" fill="#435347">
        <tspan font-weight="600" fill="#36704D">stochastic band</tspan> where outcomes overlap.
        </text>
    </g>
    </svg>
</div>
  <figcaption><span class="figure-title">Deterministic vs. stochastic decision boundaries.</span> A deterministic system has a hard boundary; an LLM has a stochastic band where the same input can land on either side.</figcaption>
</figure>