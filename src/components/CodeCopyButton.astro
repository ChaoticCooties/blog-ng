---
// Component to add copy buttons to code blocks
---

<script>
  function addCopyButtons() {
    const codeBlocks = document.querySelectorAll('pre');

    codeBlocks.forEach((pre) => {
      // Skip if this block is already wrapped
      if (pre.parentElement?.classList.contains('code-block')) return;

      // The button lives on a non-scrolling wrapper, so it stays put
      // when a long code line scrolls sideways.
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';
      pre.replaceWith(wrapper);
      wrapper.appendChild(pre);

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-button';
      button.setAttribute('aria-label', 'Copy code');
      button.innerHTML = `
        <svg class="copy-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M5.5 3.5H2.5C2.22386 3.5 2 3.72386 2 4V13.5C2 13.7761 2.22386 14 2.5 14H11.5C11.7761 14 12 13.7761 12 13.5V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M14 2H7C6.44772 2 6 2.44772 6 3V9C6 9.55228 6.44772 10 7 10H14C14.5523 10 15 9.55228 15 9V3C15 2.44772 14.5523 2 14 2Z" stroke="currentColor" stroke-width="1.5"/>
        </svg>
        <span class="copy-text" aria-live="polite">Copy</span>
        <svg class="check-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M13 4L6 11L3 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      `;

      button.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        if (!code) return;

        const text = code.textContent || '';

        const label = button.querySelector('.copy-text');
        const setState = (state, message) => {
          button.classList.remove('copied', 'failed');
          if (state) button.classList.add(state);
          if (label) label.textContent = message;
        };

        try {
          await navigator.clipboard.writeText(text);
          setState('copied', 'Copied');
        } catch (err) {
          console.error('Failed to copy:', err);
          setState('failed', 'Copy failed');
        }

        setTimeout(() => setState(null, 'Copy'), 2000);
      });

      wrapper.appendChild(button);
    });
  }

  // Run on page load
  addCopyButtons();

  // Re-run after navigation (for SPA-like behavior)
  document.addEventListener('astro:after-swap', addCopyButtons);
</script>

<style is:global>
  .code-block {
    position: relative;
  }

  .copy-button {
    min-height: 32px;
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.6rem;
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
    z-index: 10;
  }

  /* Extends the tap target to 44px while the visible chip stays compact. */
  .copy-button::before {
    content: '';
    position: absolute;
    inset: -6px;
  }

  .copy-button:hover {
    border-color: var(--ink-2);
    color: var(--ink);
  }

  .copy-button .check-icon {
    display: none;
  }

  .copy-button.copied {
    border-color: var(--accent);
    color: var(--accent);
  }

  .copy-button.copied .copy-icon {
    display: none;
  }

  .copy-button.failed {
    border-color: var(--danger);
    color: var(--danger);
  }

  .copy-button.copied .check-icon {
    display: block;
  }


</style>
