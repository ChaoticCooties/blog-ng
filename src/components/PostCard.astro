---
interface Props {
  title: string;
  date: Date;
  description: string;
  slug: string;
  category?: string;
  featured?: boolean;
}

const { title, date, description, slug, category = 'Research', featured = false } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<article class:list={["post-row", { featured }]}>
  <h2 class="post-title">
    <a href={`/blog/${slug}`}>{title}</a>
  </h2>
  <p class="post-description">{description}</p>
  <p class="post-meta">
    <span class="tag-pill">{category}</span>
    <time datetime={date.toISOString()}>{formattedDate}</time>
  </p>
</article>

<style>
  .post-row {
    position: relative;
    padding-block: 2rem 2.25rem;
    border-top: 1px solid var(--rule-strong);
  }

  .post-title {
    font-size: clamp(1.375rem, 1.15rem + 0.8vw, 1.75rem);
    line-height: 1.3;
    margin-bottom: 0.625rem;
  }

  .featured .post-title {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .featured .post-description {
    font-size: 1.1875rem;
  }

  .post-title a {
    text-decoration: none;
    transition: color 0.2s var(--ease-out);
  }

  /* The whole row is the hit target; the title link carries the accessible name. */
  .post-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-row:hover .post-title a {
    color: var(--accent);
  }

  .post-description {
    color: var(--ink-2);
    font-size: 1.0625rem;
    max-width: 58ch;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
    font-family: var(--font-ui);
    font-size: 0.875rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
</style>
