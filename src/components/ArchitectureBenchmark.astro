---
// Approximate benchmark results across scanner architecture iterations
---

<figure class="diagram architecture-benchmark">
  <div class="diagram-scroll">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 68 780 352" role="img" aria-labelledby="architecturebenchmark-title architecturebenchmark-desc">
    <title id="architecturebenchmark-title">Benchmark results by architecture</title>
    <desc id="architecturebenchmark-desc">Approximate figures from internal evaluation, not peer-reviewed, comparing scanner architectures.</desc>
    <!-- Title -->

    <!-- Y-axis -->
    <line x1="180" y1="80" x2="180" y2="330" stroke="#B9C7B2" stroke-width="1.5"/>
    <!-- Y-axis labels -->
    <text x="170" y="85" text-anchor="end" font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#56665A">100%</text>
    <line x1="175" y1="80" x2="180" y2="80" stroke="#B9C7B2" stroke-width="1.5"/>
    <text x="170" y="147" text-anchor="end" font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#56665A">75%</text>
    <line x1="175" y1="142.5" x2="730" y2="142.5" stroke="#B9C7B2" stroke-width="1" stroke-dasharray="4 4"/>
    <text x="170" y="210" text-anchor="end" font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#56665A">50%</text>
    <line x1="175" y1="205" x2="730" y2="205" stroke="#B9C7B2" stroke-width="1" stroke-dasharray="4 4"/>
    <text x="170" y="272" text-anchor="end" font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#56665A">25%</text>
    <line x1="175" y1="267.5" x2="730" y2="267.5" stroke="#B9C7B2" stroke-width="1" stroke-dasharray="4 4"/>
    <text x="170" y="335" text-anchor="end" font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#56665A">0%</text>

    <!-- X-axis -->
    <line x1="180" y1="330" x2="730" y2="330" stroke="#B9C7B2" stroke-width="1.5"/>

    <!-- GROUP 1: Semgrep Output -->
    <!-- Detection rate: ~41% -->
    <rect x="220" y="227.5" width="50" height="102.5" rx="4" fill="#36704D" stroke="#36704D" stroke-width="2"/>
    <text x="245" y="222" text-anchor="middle" font-family="'Geist', system-ui, sans-serif" font-size="11" font-weight="600" fill="#36704D">41%</text>
    <!-- False positive rate: ~76% -->
    <rect x="275" y="140" width="50" height="190" rx="4" fill="#FAFBF7" stroke="#B9C7B2" stroke-width="2"/>
    <text x="300" y="135" text-anchor="middle" font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#435347">76%</text>
    <!-- Label -->
    <text x="272" y="355" text-anchor="middle" font-family="'Geist', system-ui, sans-serif" font-size="12" font-weight="600" fill="#435347">Semgrep</text>
    <text x="272" y="370" text-anchor="middle" font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#56665A">Output</text>

    <!-- GROUP 2: Full Codebase -->
    <!-- Detection rate: ~68% -->
    <rect x="400" y="160" width="50" height="170" rx="4" fill="#36704D" stroke="#36704D" stroke-width="2"/>
    <text x="425" y="155" text-anchor="middle" font-family="'Geist', system-ui, sans-serif" font-size="11" font-weight="600" fill="#36704D">68%</text>
    <!-- False positive rate: ~52% -->
    <rect x="455" y="200" width="50" height="130" rx="4" fill="#FAFBF7" stroke="#B9C7B2" stroke-width="2"/>
    <text x="480" y="195" text-anchor="middle" font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#435347">52%</text>
    <!-- Label -->
    <text x="452" y="355" text-anchor="middle" font-family="'Geist', system-ui, sans-serif" font-size="12" font-weight="600" fill="#435347">Full</text>
    <text x="452" y="370" text-anchor="middle" font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#56665A">Codebase</text>

    <!-- GROUP 3: Agentic Retrieval -->
    <!-- Detection rate: ~79% -->
    <rect x="580" y="132.5" width="50" height="197.5" rx="4" fill="#36704D" stroke="#36704D" stroke-width="2"/>
    <text x="605" y="127" text-anchor="middle" font-family="'Geist', system-ui, sans-serif" font-size="11" font-weight="600" fill="#36704D">79%</text>
    <!-- False positive rate: ~38% -->
    <rect x="635" y="235" width="50" height="95" rx="4" fill="#FAFBF7" stroke="#B9C7B2" stroke-width="2"/>
    <text x="660" y="230" text-anchor="middle" font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#435347">38%</text>
    <!-- Label -->
    <text x="632" y="355" text-anchor="middle" font-family="'Geist', system-ui, sans-serif" font-size="12" font-weight="600" fill="#435347">Agentic</text>
    <text x="632" y="370" text-anchor="middle" font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#56665A">Retrieval</text>

    <!-- Legend -->
    <rect x="280" y="393" width="14" height="14" rx="3" fill="#36704D" stroke="#36704D" stroke-width="2"/>
    <text x="300" y="405" font-family="'Geist', system-ui, sans-serif" font-size="12" font-weight="600" fill="#36704D">Detection Rate</text>
    <rect x="420" y="393" width="14" height="14" rx="3" fill="#FAFBF7" stroke="#B9C7B2" stroke-width="2"/>
    <text x="440" y="405" font-family="'Geist', system-ui, sans-serif" font-size="12" fill="#435347">False Positive Rate</text>
  </svg>
</div>
  <figcaption><span class="figure-title">Benchmark results by architecture.</span> Approximate figures from internal evaluation, not peer-reviewed.</figcaption>
</figure>
