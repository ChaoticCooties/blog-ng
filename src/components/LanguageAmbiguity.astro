<figure class="diagram languageambiguity-diagram">
  <div class="diagram-scroll">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 82 900 398" role="img" aria-labelledby="languageambiguity-title languageambiguity-desc">
    <title id="languageambiguity-title">Language ambiguity</title>
    <desc id="languageambiguity-desc">The same phrase can map to very different meanings depending on context.</desc>
    <!-- Arrow defs -->
    <defs>
        <marker id="arrow-soft" markerWidth="10" markerHeight="10"
                refX="9" refY="3" orient="auto">
        <polygon points="0 0, 10 3, 0 6" fill="#7C8E7D"/>
        </marker>
    </defs>

    <!-- Title -->

    <!-- Main panel -->
    <rect x="60" y="90" width="780" height="330" rx="6"
            fill="none" stroke="#B9C7B2" stroke-width="2"/>

    <!-- Column headers -->
    <text x="120" y="120"
            font-family="'Geist', system-ui, sans-serif"
            font-size="13" font-weight="600" fill="#435347">
        Same Phrase
    </text>
    <text x="510" y="120"
            font-family="'Geist', system-ui, sans-serif"
            font-size="13" font-weight="600" fill="#435347">
        Possible Interpretations
    </text>

    <!-- ================= Row 1: "Open the file" ================= -->

    <!-- Phrase box -->
    <rect x="80" y="140" width="210" height="42" rx="6"
            fill="#FAFBF7" stroke="#B9C7B2" stroke-width="2"/>
    <text x="185" y="167" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="14" fill="#1C2B21">
        “Open the file”
    </text>

    <!-- Arrows -->
    <line x1="290" y1="161" x2="350" y2="145"
            stroke="#7C8E7D" stroke-width="2" marker-end="url(#arrow-soft)"/>
    <line x1="290" y1="161" x2="350" y2="161"
            stroke="#7C8E7D" stroke-width="2" marker-end="url(#arrow-soft)"/>
    <line x1="290" y1="161" x2="350" y2="177"
            stroke="#7C8E7D" stroke-width="2" marker-end="url(#arrow-soft)"/>

    <!-- Meaning pills -->
    <rect x="370" y="135" width="180" height="26" rx="13"
            fill="#DCE8D9" stroke="#36704D" stroke-width="1.5"/>
    <text x="460" y="152" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#36704D">
        Literal: open a document
    </text>

    <rect x="560" y="135" width="200" height="26" rx="13"
            fill="#FAFBF7" stroke="#B9C7B2" stroke-width="1.5"/>
    <text x="660" y="152" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#435347">
        Reveal internal/system state
    </text>

    <rect x="370" y="165" width="200" height="26" rx="13"
            fill="#FAFBF7" stroke="#B9C7B2" stroke-width="1.5"/>
    <text x="470" y="182" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#435347">
        Summarize/explain a file
    </text>

    <!-- ================= Row 2: "Run the program" ================= -->

    <!-- Phrase box -->
    <rect x="80" y="215" width="210" height="42" rx="6"
            fill="#FAFBF7" stroke="#B9C7B2" stroke-width="2"/>
    <text x="185" y="242" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="14" fill="#1C2B21">
        “Run the program”
    </text>

    <!-- Arrows -->
    <line x1="290" y1="236" x2="350" y2="220"
            stroke="#7C8E7D" stroke-width="2" marker-end="url(#arrow-soft)"/>
    <line x1="290" y1="236" x2="350" y2="236"
            stroke="#7C8E7D" stroke-width="2" marker-end="url(#arrow-soft)"/>
    <line x1="290" y1="236" x2="350" y2="252"
            stroke="#7C8E7D" stroke-width="2" marker-end="url(#arrow-soft)"/>

    <!-- Meaning pills -->
    <rect x="370" y="210" width="180" height="26" rx="13"
            fill="#DCE8D9" stroke="#36704D" stroke-width="1.5"/>
    <text x="460" y="227" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#36704D">
        Explain how the code runs
    </text>

    <rect x="560" y="210" width="200" height="26" rx="13"
            fill="#FAFBF7" stroke="#B9C7B2" stroke-width="1.5"/>
    <text x="660" y="227" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#435347">
        Execute something (dangerous)
    </text>

    <rect x="370" y="240" width="200" height="26" rx="13"
            fill="#FAFBF7" stroke="#B9C7B2" stroke-width="1.5"/>
    <text x="470" y="257" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#435347">
        Part of a fictional narrative
    </text>

    <!-- ================= Row 3: "Find the key" ================= -->

    <!-- Phrase box -->
    <rect x="80" y="290" width="210" height="42" rx="6"
            fill="#FAFBF7" stroke="#B9C7B2" stroke-width="2"/>
    <text x="185" y="317" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif"
            font-size="14" fill="#1C2B21">
        “Find the key”
    </text>

    <!-- Arrows -->
    <line x1="290" y1="311" x2="350" y2="295"
            stroke="#7C8E7D" stroke-width="2" marker-end="url(#arrow-soft)"/>
    <line x1="290" y1="311" x2="350" y2="311"
            stroke="#7C8E7D" stroke-width="2" marker-end="url(#arrow-soft)"/>
    <line x1="290" y1="311" x2="350" y2="327"
            stroke="#7C8E7D" stroke-width="2" marker-end="url(#arrow-soft)"/>

    <!-- Meaning pills -->
    <rect x="370" y="285" width="180" height="26" rx="13"
            fill="#DCE8D9" stroke="#36704D" stroke-width="1.5"/>
    <text x="460" y="302" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#36704D">
        Literal: locate a lost object
    </text>

    <rect x="560" y="285" width="200" height="26" rx="13"
            fill="#FAFBF7" stroke="#B9C7B2" stroke-width="1.5"/>
    <text x="660" y="302" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#435347">
        Find a cryptographic key (attack!)
    </text>

    <rect x="370" y="315" width="210" height="26" rx="13"
            fill="#FAFBF7" stroke="#B9C7B2" stroke-width="1.5"/>
    <text x="475" y="332" text-anchor="middle"
            font-family="'Geist', system-ui, sans-serif" font-size="11" fill="#435347">
        Interpret metaphorically (“key idea”)
    </text>
    </svg>
</div>
  <figcaption><span class="figure-title">Language ambiguity.</span> The same phrase can map to very different meanings depending on context.</figcaption>
</figure>