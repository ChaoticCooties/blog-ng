<style>
  .artifact-permission { position: relative; }
  .artifact-permission .row:focus { outline: none; }
  .artifact-permission .row:focus-visible .hit {
    outline: 2px solid var(--accent, #36704D); outline-offset: -2px;
  }
  .artifact-permission .row:is(:hover, :focus-visible) circle { r: 6; }
  .artifact-permission .row:is(:hover, :focus-visible) text { font-weight: 600; }
  .ap-tip {
    position: absolute; top: 0; left: 0; z-index: 5; pointer-events: none;
    width: max-content; max-width: min(21rem, 72%);
    padding: 0.4rem 0.55rem;
    background: var(--paper, #FAFBF7); color: var(--ink-2, #435347);
    border: 1px solid var(--rule-strong, #B9C7B2); border-radius: 6px;
    box-shadow: 0 3px 14px rgba(28, 43, 33, 0.16);
    font-size: 0.75rem; line-height: 1.45; font-variant-numeric: tabular-nums;
  }
  .ap-tip :global(b) { color: var(--accent, #36704D); }
  .ap-tip :global(.muted) { color: var(--ink-3, #56665A); }
  .ap-tip :global(.sep) { color: var(--rule-strong, #B9C7B2); padding: 0 0.3rem; }
  .ap-tip :global(q) {
    display: block; color: var(--ink-3, #56665A); font-style: italic; margin: 0.15rem 0 0.3rem;
  }
  .ap-tip :global(q)::before { content: "“"; }
  .ap-tip :global(q)::after { content: "”"; }
</style>

<script>
  document.querySelectorAll("[data-ap]").forEach((fig) => {
    const tip = fig.querySelector(".ap-tip");
    if (!tip) return;
    const place = (cx, cy) => {
      const fr = fig.getBoundingClientRect();
      const tw = tip.offsetWidth, th = tip.offsetHeight;
      let left = cx - fr.left + 16, top = cy - fr.top + 16;
      if (left + tw > fr.width - 4) left = cx - fr.left - tw - 16;
      if (left < 4) left = 4;
      if (top + th > fr.height - 4) top = cy - fr.top - th - 16;
      if (top < 4) top = 4;
      tip.style.transform = "translate(" + left + "px," + top + "px)";
    };
    const fill = (row) => {
      const d = row.dataset;
      tip.innerHTML =
        "<b>" + d.name + "</b> <span class='muted'>" + d.fam + "</span>" +
        "<q>" + d.carrier + "</q>" +
        "<span class='muted'>Llama</span> " + d.dl + " \u00b1 " + d.ml +
        "<span class='sep'>|</span><span class='muted'>Qwen</span> " + d.dq + " \u00b1 " + d.mq;
      tip.hidden = false;
    };
    const hide = () => { tip.hidden = true; };
    let pending = null;
    fig.querySelectorAll(".row").forEach((row) => {
      row.addEventListener("pointerenter", (e) => { fill(row); place(e.clientX, e.clientY); });
      row.addEventListener("pointermove", (e) => {
        if (tip.hidden) fill(row);
        if (pending) cancelAnimationFrame(pending);
        pending = requestAnimationFrame(() => place(e.clientX, e.clientY));
      });
      row.addEventListener("pointerleave", hide);
      row.addEventListener("focus", () => {
        fill(row);
        const rr = row.getBoundingClientRect();
        place(rr.left + rr.width * 0.30, rr.top + rr.height / 2);
      });
      row.addEventListener("blur", hide);
    });
    fig.addEventListener("pointerleave", hide);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") hide(); });
  });
</script>
