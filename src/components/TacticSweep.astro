  .sweep-controls button[aria-pressed="true"] {
    background: var(--fern-wash, #DCE8D9); border-color: var(--accent, #36704D);
    color: var(--accent, #36704D); font-weight: 600;
  }
  .tactic-sweep .row { transition: transform 480ms cubic-bezier(.4,0,.2,1); }
  .tactic-sweep .row:focus { outline: none; }
  .tactic-sweep .row:focus-visible .hit {
    outline: 2px solid var(--accent, #36704D); outline-offset: -2px;
  }
  .tactic-sweep .row:is(:hover, :focus-visible) rect:not(.hit) { filter: brightness(1.12); }
  .tactic-sweep .row:is(:hover, :focus-visible) text { font-weight: 600; }
  .tactic-sweep[data-sort="usage"] .row { transform: translateY(var(--dy)); }
  .tactic-sweep .ct { opacity: 0.75; }
  .tactic-sweep[data-sort="usage"] .ct { opacity: 1; font-weight: 600; }
  .sweep-tip {
    position: absolute; top: 0; left: 0; z-index: 5; pointer-events: none;
    width: max-content; max-width: min(21rem, 72%);
    padding: 0.4rem 0.55rem;
    background: var(--paper, #FAFBF7); color: var(--ink-2, #435347);
    border: 1px solid var(--rule-strong, #B9C7B2); border-radius: 6px;
    box-shadow: 0 3px 14px rgba(28, 43, 33, 0.16);
    font-size: 0.75rem; line-height: 1.45; font-variant-numeric: tabular-nums;
  }
  .sweep-tip :global(b) { color: var(--accent, #36704D); }
  .sweep-tip :global(.muted) { color: var(--ink-3, #56665A); }
  .sweep-tip :global(.sep) { color: var(--rule-strong, #B9C7B2); padding: 0 0.3rem; }
  .sweep-tip :global(q) { display: block; color: var(--ink-3, #56665A); font-style: italic; margin: 0.15rem 0 0.3rem; }
  .sweep-tip :global(q)::before { content: "“"; }
  .sweep-tip :global(q)::after { content: "”"; }
  @media (prefers-reduced-motion: reduce) {
    .tactic-sweep .row { transition: none; }
  }
</style>

<script>
  document.querySelectorAll("[data-tactic-sweep]").forEach((fig) => {
    const controls = fig.querySelector(".sweep-controls");
    const tip = fig.querySelector(".sweep-tip");
    if (!controls || !tip) return;
    controls.hidden = false;
    fig.dataset.sort = "effect";

    controls.addEventListener("click", (e) => {
      const btn = e.target.closest("button[data-sort]");
      if (!btn) return;
      fig.dataset.sort = btn.dataset.sort;
      controls.querySelectorAll("button").forEach((b) =>
        b.setAttribute("aria-pressed", String(b === btn)));
    });

    const place = (cx, cy) => {
      const fr = fig.getBoundingClientRect();
      const tw = tip.offsetWidth, th = tip.offsetHeight;
      let left = cx - fr.left + 16;
      let top = cy - fr.top + 16;
      if (left + tw > fr.width - 4) left = cx - fr.left - tw - 16;
      if (left < 4) left = 4;
      if (top + th > fr.height - 4) top = cy - fr.top - th - 16;
      if (top < 4) top = 4;
      tip.style.transform = "translate(" + left + "px," + top + "px)";
    };

    const fill = (row) => {
      const d = row.dataset;
      tip.innerHTML =
        "<b>" + d.name + "</b><q>" + d.carrier + "</q>" +
        d.d + " ± " + d.mde +
        "<span class='sep'>|</span><span class='muted'>phrasings</span> " + d.t0 + " / " + d.t1 +
        "<span class='sep'>|</span>" + d.count + " <span class='muted'>uses</span>";
      tip.hidden = false;
    };
    const hide = () => { tip.hidden = true; };

    let pending = null;
    fig.querySelectorAll(".row").forEach((row) => {
      row.addEventListener("pointerenter", (e) => { fill(row); place(e.clientX, e.clientY); });
      row.addEventListener("pointermove", (e) => {
        if (tip.hidden) fill(row);
        if (pending) cancelAnimationFrame(pending);
        pending = requestAnimationFrame(() => place(e.clientX, e.clientY));
      });
      row.addEventListener("pointerleave", hide);
      row.addEventListener("focus", () => {
        fill(row);
        const rr = row.getBoundingClientRect();
        place(rr.left + rr.width * 0.30, rr.top + rr.height / 2);
      });
      row.addEventListener("blur", hide);
    });
    fig.addEventListener("pointerleave", hide);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") hide(); });
  });
</script>
